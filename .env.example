# API Keys — only set the key for the provider you're using
# LiteLLM supports 100+ providers. See full list: https://docs.litellm.ai/docs/providers
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Format: provider/model_id
# Examples:
#   groq/llama-3.3-70b-versatile
#   openai/gpt-4o
#   gemini/gemini-2.0-flash
#   anthropic/claude-sonnet-4-20250514
#   azure/my-deployment-name
#   ollama/llama3
# Full model list: https://docs.litellm.ai/docs/providers
MODEL_NAME=groq/llama-3.3-70b-versatile

API_SECRET_TOKEN=your_api_secret_token_here